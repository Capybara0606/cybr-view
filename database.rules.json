{
  "rules": {
    "cybrview": {
      "v1": {
        "tokens": {
          "$token": {
            ".read": "auth != null || (data.child('status').val() === 'active' && data.child('reviewStatus').val() !== 'DRAFT')",
            ".write": "auth != null"
          }
        },
        "reviews": {
          "$token": {
            ".read": "auth != null || (root.child('cybrview/v1/tokens').child($token).child('status').val() === 'active' && root.child('cybrview/v1/tokens').child($token).child('reviewStatus').val() !== 'DRAFT')",
            ".write": "auth != null",
            "approval": {
              ".write": "auth != null || (root.child('cybrview/v1/tokens').child($token).child('status').val() === 'active' && root.child('cybrview/v1/tokens').child($token).child('reviewStatus').val() !== 'DRAFT')"
            },
            "comments": {
              "$commentId": {
                ".write": "auth != null || (root.child('cybrview/v1/tokens').child($token).child('status').val() === 'active' && root.child('cybrview/v1/tokens').child($token).child('reviewStatus').val() !== 'DRAFT')"
              }
            }
          }
        },
        "projects": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
