{
  "rules": {
    "cybrview": {
      "v1": {
        "tokens": {
          "$token": {
            ".read": true,
            ".write": "auth != null"
          }
        },
        "reviews": {
          "$token": {
            ".read": true,
            ".write": "root.child('cybrview/v1/tokens').child($token).exists()",
            "approval": {
              ".write": "root.child('cybrview/v1/tokens').child($token).exists()"
            },
            "comments": {
              "$commentId": {
                ".read": true,
                ".write": "root.child('cybrview/v1/tokens').child($token).exists()"
              }
            }
          }
        },
        "projects": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
